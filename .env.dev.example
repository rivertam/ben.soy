# Copy to .env.dev (gitignored) for local secrets that `just dev` should
# pick up. scripts/dev.sh pins the local SurrealDB connection, sync tokens,
# COOKIE_KEY, and SITE_ORIGIN — do not put production database settings here.
#
# cp .env.dev.example .env.dev

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Hidden-page allowlists (docs/auth.md): /path:email,email;/path2:email
HIDDEN_PAGE_ACCESS=

# Podrick (docs/podrick.md). Setting any Podrick channel here makes `just dev`
# start the bot beside the site, pinned to the local database and API.
# Point every value at TEST channels, never the real server: local Pants Off
# polling is live Discord I/O even though its database is local.
PODRICK_LIFT_CHANNEL_ID=
# These two are a pair: source ritual channel, then infarction notices.
PODRICK_PANTS_CHANNEL_ID=
PODRICK_INFARCTIONS_CHANNEL_ID=
# Optional: otherwise the token comes from ~/.config/benjisponge/podrick.token
DISCORD_BOT_TOKEN=

# Machine token for GET /api/podrick/seed (docs/podrick.md). When set, local
# reset/empty podrick_* state pulls the full production Podrick snapshot
# instead of rebuilding from Discord.
PODRICK_SYNC_TOKEN=
# Optional override; defaults to https://benjisponge.com/api/podrick/seed
# PODRICK_SEED_URL=
