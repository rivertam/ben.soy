# Copy to .env.dev (gitignored) for local secrets that `just dev` should
# pick up. scripts/dev.sh still pins local Postgres, sync tokens,
# COOKIE_KEY, and SITE_ORIGIN — do not put a prod POSTGRES_URL here.
#
# cp .env.dev.example .env.dev

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Hidden-page allowlists (docs/auth.md): /path:email,email;/path2:email
HIDDEN_PAGE_ACCESS=
