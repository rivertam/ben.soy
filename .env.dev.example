# Copy to .env.dev (gitignored) for local secrets that `just dev` should
# pick up. scripts/dev.sh pins the local SurrealDB connection, sync tokens,
# COOKIE_KEY, and SITE_ORIGIN — do not put production database settings here.
#
# cp .env.dev.example .env.dev

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Hidden-page allowlists (docs/auth.md): /path:email,email;/path2:email
HIDDEN_PAGE_ACCESS=

# Podrick (docs/podrick.md). Setting a channel here is what makes `just dev`
# start the bot beside the site — pinned to the local database and API — so a
# lift pasted into the local upload dialog is announced in this channel.
# Point it at a test channel, not the real one. `just dev --no-podrick` skips it.
PODRICK_LIFT_CHANNEL_ID=
# Optional: otherwise the token comes from ~/.config/benjisponge/podrick.token
DISCORD_BOT_TOKEN=
